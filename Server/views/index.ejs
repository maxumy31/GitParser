<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitPulse Hub | Аналитика</title>
    <script src="https://unpkg.com/htmx.org@2.0.0"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@500;600&display=swap');
        body { font-family: 'Geist Sans', sans-serif; }
        .data-mono { font-family: 'Geist Mono', monospace; }
        
        /* Индикатор загрузки по умолчанию скрыт */
        .htmx-indicator { display: none; }
        .htmx-request .htmx-indicator { display: flex; }
        .htmx-request.htmx-indicator { display: flex; }

        .htmx-added { opacity: 0; }
        .htmx-settling { opacity: 1; transition: opacity 200ms ease-in; }
    </style>
</head>
<body class="bg-white text-slate-900 antialiased h-screen flex flex-col overflow-hidden">
    
    <%- include('partials/header') %>

    <div class="flex flex-1 overflow-hidden">
        <%- include('partials/sidebar') %>
        
        <main class="flex-1 overflow-y-auto bg-white p-12">
            <div id="table-container">
                <%- include('partials/table', { tag: null, libraries: initialData , pagination: {total: 0, current:1, pages: 1}}) %>
            </div>
        </main>
    </div>

    <div id="loader" class="htmx-indicator fixed bottom-8 right-8 bg-indigo-600 text-white px-4 py-2 rounded-full shadow-lg items-center gap-2">
        <i class="fas fa-spinner animate-spin"></i>
        <span class="text-xs font-bold uppercase tracking-widest">Обновление...</span>
    </div>

</body>
</html>
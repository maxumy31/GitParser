<div class="mt-12 flex items-center justify-center gap-2 border-t border-zinc-100 pt-8" id="paginator-container">
<%
        const currentPage = Number(activePage) || 1;
        const totalPages = pagesCount <= 0 ? 1 : pagesCount;
        const displayCount = 11;
        
        let startPage, endPage;
        if (totalPages <= displayCount) {
            startPage = 1;
            endPage = totalPages;
        } else {
            const half = Math.floor(displayCount / 2);
            
            if (currentPage <= half) {
                startPage = 1;
                endPage = displayCount;
            } else if (currentPage + half >= totalPages) {
                startPage = totalPages - displayCount + 1;
                endPage = totalPages;
            } else {
                startPage = currentPage - half;
                endPage = currentPage + half;
            }
        }
        const pagesArr = Array.from({ length: (endPage - startPage) + 1 }, (_, i) => startPage + i);
    %>
    <input type="hidden" id="page" value="<%=activePage%>" name="page"/>
    <div class="flex items-center gap-1">
        <% pagesArr.forEach(elt => { %>
        <% if(activePage == elt) { %>
            <button
                class="min-w-[40px] h-10 rounded-xl text-sm font-bold bg-indigo-600 text-white shadow-md shadow-indigo-200 cursor-default">
                <%= elt %>
            </button>
        <% }  else { %>
        <button 
            hx-get="/library_page/search_results"
            hx-vals='{"page":"<%=elt%>","language":"<%= language %>","library":"<%= name %>"}'
            hx-swap="outerHTML"
            hx-target="#search-result-block"
            class="min-w-[40px] h-10 rounded-xl text-sm font-semibold text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 transition-all">
            <%= elt %>
        </button>
        <% }}) %>
    </div>
</div>
<% activeTags.forEach(tag=> { -%>
    <div
        class="inline-flex items-center w-max gap-1.5 bg-white border border-indigo-200 text-indigo-600 px-2 py-1 rounded-md shadow-sm">
        <span class="text-[10px] font-bold uppercase tracking-wider">
            <%= tag %>
        </span>
        <button class="hover:text-red-500 transition-colors" 
            hx-swap="delete" 
            hx-target="closest div" 
            hx-get="/search_page/search_trigger">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <path
                    d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z">
                </path>
            </svg>
        </button>
        <input type="hidden" name="activeTags" value="<%= tag %>">
    </div>
    <% }) -%>
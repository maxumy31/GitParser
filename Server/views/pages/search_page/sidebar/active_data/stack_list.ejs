<% activeStack.forEach(stack=> { %>
    <div
        class="inline-flex items-center gap-1.5 bg-indigo-600 text-white px-2 py-1 rounded-md shadow-sm border border-indigo-500">
        <span class="text-xs font-semibold mono"><%-stack%></span>
        <button class="hover:text-indigo-200 transition-colors" title="Удалить"
            hx-swap="delete" 
            hx-target="closest div" 
            hx-get="/search_page/search_trigger">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                </path>
            </svg>
        </button>
        <input type="hidden" value="<%-stack%>" name="activeStack" />
    </div>
<% }) %>
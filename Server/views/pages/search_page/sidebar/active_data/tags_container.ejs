        <label class="text-[10px] font-bold text-zinc-400 uppercase tracking-[0.2em]">Активные теги</label>
        <button onclick="document.getElementById('tags-modal').showModal()" 
                class="text-[10px] font-bold text-indigo-600 hover:text-indigo-700 uppercase tracking-wider flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            Поиск
        </button>

<div class="mt-12 flex items-center justify-center gap-2 border-t border-zinc-100 pt-8" id="paginator-container">
    <%
        const displayCount = 11
        const count = pagesCount == 0 ? 1 : pagesCount
        let pagesArr = []
        const displayHalf = Math.ceil(displayCount/2)
        if(activePage - displayHalf < 0) { // 1 >2 3 4 5 6...
            pagesArr = Array.from({length: Math.min(displayCount,count)}, (_, i) => i + 1)
        } else if(activePage + displayHalf > count) {// ... 6 7 8 9 >10 11
            const offset = count - displayCount
            pagesArr = Array.from({length: Math.min(displayCount,count)}, (_, i) => i + 1 + offset)
        } else { // ... 5 6 >7 8 9 ...
            const offset = activePage - displayHalf
            pagesArr = Array.from({length: Math.min(displayCount,count)}, (_, i) => i + 1 + offset)
        }

     %>
    <input type="hidden" id="page" value="<%=activePage%>" name="page"/>
    <div class="flex items-center gap-1">
        <% pagesArr.forEach(elt => { %>
        <% if(activePage == elt) { %>
            <button
                class="min-w-[40px] h-10 rounded-xl text-sm font-bold bg-indigo-600 text-white shadow-md shadow-indigo-200 cursor-default">
                <%= elt %>
            </button>
        <% }  else { %>
        <button 
            hx-get="/search-page/search_results_list"
            hx-vals='{"page":"<%=elt%>"}'
            hx-target="#search-result-block"
            hx-swap="outerHTML"
            hx-include="#language_selector, #sources_container input, #stack-container, #active-tags-block, #searchbar"
            class="min-w-[40px] h-10 rounded-xl text-sm font-semibold text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 transition-all disabled:text-zinc-200">
            <%= elt %>
        </button>
        <% }}) %>
    </div>
</div>
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Поиск — LibRec</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .mono { font-family: 'JetBrains Mono', monospace; }

        .htmx-indicator {
        display:none;
        }
        .htmx-request .htmx-indicator {
            display:inline;
        }
        .htmx-settling img {
            opacity: 0;
        }
        .htmx-request.main-content {
            opacity: 0.5;
            transition: opacity 200ms ease-in;
        }
    </style>
</head>
<body class="bg-white text-zinc-900 antialiased">
    <nav class="border-b border-zinc-100 bg-white/80 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-8">
                <a href="/" class="text-xl font-bold tracking-tight text-indigo-600">Lib<span class="text-zinc-900">Rec</span></a>
                <div class="flex gap-6 text-sm font-medium text-zinc-400">
                    <a href="/" class="hover:text-zinc-900 transition-colors">Главная</a>
                    <span class="text-zinc-900 underline decoration-indigo-500 underline-offset-4">Поиск</span>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-6 py-8">
        <div class="flex flex-col lg:flex-row gap-12">
            
            <aside class="w-full lg:w-64 flex-shrink-0 space-y-10">
                <section>
                    <%- include("source_selector_block.ejs",{sources:searchPageData.sources}) %>
                </section>

                <section>
                    <%- include("language_selector_block.ejs",{languages:searchPageData.languages}) %>
                </section>

                <section>
                    <%- include("popular_tags_block.ejs",{tags:searchPageData.popularTags}) %>
                </section>
            </aside>

            <div class="flex-grow">
                <div class="bg-zinc-50 border border-zinc-100 rounded-2xl p-4 mb-8">
                    <div class="relative mb-4">
                        <input type="text" 
                               placeholder="Поиск по названию или описанию..." 
                               class="w-full bg-white border border-zinc-200 rounded-xl py-3 pl-4 pr-12 outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all font-medium">
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 text-zinc-400">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-[10px] font-bold text-zinc-400 uppercase mr-2">Ваш стек:</span>
                        <div class="flex items-center gap-1.5 bg-white border border-zinc-200 px-2 py-1 rounded-md shadow-sm">
                            <span class="text-xs font-semibold mono">react</span>
                            <button class="text-zinc-400 hover:text-red-500 transition-colors">
                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"></path></svg>
                            </button>
                        </div>
                        <div class="flex items-center gap-1.5 bg-white border border-zinc-200 px-2 py-1 rounded-md shadow-sm">
                            <span class="text-xs font-semibold mono">zod</span>
                            <button class="text-zinc-400 hover:text-red-500 transition-colors">
                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"></path></svg>
                            </button>
                        </div>
                        <button class="text-[10px] text-zinc-400 hover:text-indigo-600 underline underline-offset-2 ml-2">Очистить всё</button>
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="flex justify-between items-center px-2">
                        <h2 class="text-sm font-bold text-zinc-900">Результаты <span class="text-zinc-400 font-normal ml-2">12 найденных библиотек</span></h2>
                    </div>

                    <div class="group bg-white border border-zinc-200 rounded-xl p-5 hover:border-indigo-300 hover:shadow-lg hover:shadow-indigo-500/5 transition-all flex items-center justify-between">
                        <div class="flex gap-5">
                            <div class="w-12 h-12 bg-zinc-50 border border-zinc-100 rounded-lg flex items-center justify-center font-bold text-zinc-400 group-hover:bg-indigo-50 group-hover:text-indigo-500 transition-colors">A</div>
                            <div>
                                <h3 class="font-bold text-zinc-900">Axios</h3>
                                <p class="text-sm text-zinc-500 max-w-lg mt-1 line-clamp-1">Promise based HTTP client for the browser and node.js</p>
                                <div class="flex gap-3 mt-3">
                                    <span class="text-[10px] mono font-bold text-zinc-400 px-1.5 py-0.5 border border-zinc-100 rounded">HTTP</span>
                                    <span class="text-[10px] mono font-bold text-zinc-400 px-1.5 py-0.5 border border-zinc-100 rounded">CLIENT</span>
                                </div>
                            </div>
                        </div>
                        <button class="p-2 border border-zinc-200 rounded-lg text-zinc-400 hover:text-indigo-600 hover:border-indigo-600 hover:bg-indigo-50 transition-all">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                        </button>
                    </div>

                    <div class="group bg-white border border-zinc-200 rounded-xl p-5 hover:border-indigo-300 hover:shadow-lg hover:shadow-indigo-500/5 transition-all flex items-center justify-between">
                        <div class="flex gap-5">
                            <div class="w-12 h-12 bg-zinc-50 border border-zinc-100 rounded-lg flex items-center justify-center font-bold text-zinc-400 group-hover:bg-indigo-50 group-hover:text-indigo-500 transition-colors">T</div>
                            <div>
                                <h3 class="font-bold text-zinc-900">TanStack Query</h3>
                                <p class="text-sm text-zinc-500 max-w-lg mt-1 line-clamp-1">Powerful asynchronous state management for TS/JS.</p>
                                <div class="flex gap-3 mt-3">
                                    <span class="text-[10px] mono font-bold text-zinc-400 px-1.5 py-0.5 border border-zinc-100 rounded">STATE</span>
                                    <span class="text-[10px] mono font-bold text-zinc-400 px-1.5 py-0.5 border border-zinc-100 rounded">ASYNC</span>
                                </div>
                            </div>
                        </div>
                        <button class="p-2 border border-zinc-200 rounded-lg text-zinc-400 hover:text-indigo-600 hover:border-indigo-600 hover:bg-indigo-50 transition-all text-sm px-4 font-semibold">
                            Выбрать
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </main>

</body>
</html>
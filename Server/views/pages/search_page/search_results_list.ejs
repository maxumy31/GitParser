<div name="search-result-block" id="search-result-block" class="space-y-4"
    hx-trigger="updateSearchResult from:body" 
    hx-get="/search-page/search_results_list"
    hx-include="#language_selector, #sources_container input, #stack-container, #active-tags-block, #searchbar"
    hx-disabled-elt="#search-results-item > button">
    <div class="flex justify-between items-center px-2">
        <h2 class="text-sm font-bold text-zinc-900">Результаты <span class="text-zinc-400 font-normal ml-2">
                <%=searchResult.count%> найденных библиотек</span>
        </h2>
        <h2 class="font-normal ml-2 text-zinc-400 text-sm"><%=pagesCount%> страниц</h2>
    </div>
    <% searchResult.names.forEach(name=> {%>
        <div id = "search-results-item"
            class="group bg-white border border-zinc-200 rounded-xl p-3 pl-4 hover:border-indigo-300 hover:shadow-md transition-all flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div
                    class="w-8 h-8 bg-zinc-50 border border-zinc-100 rounded flex items-center justify-center text-xs font-bold text-zinc-400 group-hover:bg-indigo-50 group-hover:text-indigo-500 transition-colors">
                    <%= name[0].toUpperCase() %>
                </div>

                <h3 class="font-semibold text-zinc-900 leading-none">
                    <%= name %>
                </h3>
            </div>

            
            <div class="flex flex-row gap-3">
                <a  hx-get="/library_page"
                    hx-vals='{"library":"<%= name %>"}'
                    hx-include="#language_selector"
                    hx-params="library, language"
                    hx-push-url="true"
                    hx-swap="outerHTML"
                    hx-target="body"
                    class="p-2 rounded-lg hover:bg-zinc-100 text-zinc-400 hover:text-indigo-600 transition-all">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </a>
                <button hx-get="/search_page/stack_list" 
                    hx-target="#active-stack-list"
                    hx-swap="beforeend"
                    hx-vals='{"toInclude": "<%= name %>"}'
                    hx-params="toInclude"
                    class="p-1.5 border border-zinc-200 rounded-md text-zinc-400 transition-all 
                        enabled:hover:text-indigo-600 enabled:hover:border-indigo-600 enabled:hover:bg-indigo-50 
                        disabled:opacity-50 disabled:cursor-not-allowed disabled:bg-zinc-100 disabled:border-zinc-200"
                    title="Добавить в стек">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                </button>
            </div>

        </div>
    <% }) %>
    <%- include("paginator",{activePage:page,pagesCount:pagesCount}) %>
</div>
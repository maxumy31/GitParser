<ul class="divide-y divide-slate-800">
    <% rows.forEach(row => { %>
        <li class="px-4 py-3 hover:bg-slate-800 cursor-pointer flex items-center justify-between group transition-colors"
            hx-post="/search"
            hx-vals='{"q": "<%= row.name %>"}'
            hx-target="#table-container"
            hx-indicator="#loader"
            hx-on:click="document.getElementById('main-search').value = '<%= row.name %>'; document.getElementById('search-results').innerHTML = '';">

            <div class="flex items-center gap-3">
                <i class="fas fa-hashtag text-slate-600 group-hover:text-indigo-400 text-xs"></i>
                <span class="text-sm text-slate-300 group-hover:text-white font-medium"><%= row.name %></span>
            </div>
        </li>
    <% }) %>
</ul>
<header class="h-16 bg-slate-950 flex items-center px-8 shrink-0 z-40">
    <div class="flex items-center gap-4 w-64">
        <div class="w-8 h-8 bg-indigo-600 rounded-md flex items-center justify-center shadow-lg shadow-indigo-500/20">
            <i class="fas fa-microchip text-white text-sm"></i>
        </div>
        <span class="text-white font-bold text-lg tracking-tight">GitPulse Hub</span>
    </div>

    <div class="relative flex-1 max-w-2xl ml-8 group">
        <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 z-10"></i>
        
        <input type="text" 
               name="q"
               id="main-search"
               placeholder="Введите тег..."
               autocomplete="off"
               class="w-full bg-slate-900 border border-slate-800 rounded-lg py-2.5 pl-12 pr-4 text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all shadow-inner relative z-10"
               
               hx-get="/suggestions" 
               hx-trigger="keyup changed delay:200ms" 
               hx-target="#search-results"

               hx-on::after-request="if(event.detail.target.id === 'search-results' && event.detail.xhr.status === 204) document.getElementById('search-results').innerHTML = ''"
               
               onkeydown="if(event.key === 'Enter') { 
                  htmx.ajax('POST', '/search', {target: '#table-container', values: {q: this.value}, indicator: '#loader'});
                  document.getElementById('search-results').innerHTML = '';
               }"
               
               onblur="setTimeout(() => document.getElementById('search-results').innerHTML='', 250)">

        <div id="search-results" class="absolute top-full left-0 w-full mt-1 bg-slate-900 border border-slate-800 rounded-lg shadow-2xl z-50 overflow-hidden">
        </div>
    </div>
</header>
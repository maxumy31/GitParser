<div id="table-container" class="max-w-6xl mx-auto">
    <div class="flex items-center gap-3 mb-2">
        <span class="px-2.5 py-1 bg-indigo-600 text-white text-[11px] font-bold rounded uppercase tracking-wider">
            <%= tag ? 'Текущий тег' : 'Тег не выбран' %>
        </span>
        <span class="text-indigo-600 font-bold text-sm tracking-wide"><%= tag %></span>
        
        <input type="hidden" id="sidebar-q-sync" name="q" value="<%= tag %>" hx-swap-oob="true">
    </div>
    
    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-10">Анализ экосистемы</h1>

    <% if (libraries.length > 0 && typeof columns !== 'undefined') { %>
        <div class="ring-1 ring-slate-200 rounded-xl overflow-hidden shadow-sm bg-white">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-slate-50">
                        <% columns.forEach(col => { %>
                            <th class="px-6 py-4 text-[11px] font-bold text-slate-400 uppercase tracking-widest border-b border-slate-200 
                                       <%= col.align === 'right' ? 'text-right' : 'text-left' %>">
                                <%= col.label %>
                            </th>
                        <% }) %>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% libraries.forEach(item => { %>
                        <tr class="group hover:bg-indigo-50/50 transition-colors odd:bg-white even:bg-slate-50/50">
                            <% columns.forEach(col => { %>
                                <td class="px-6 py-4 tracking-tight transition-colors
                                           <%= col.align === 'right' ? 'text-right data-mono font-bold text-indigo-600' : 'text-left text-slate-800' %>
                                           <%= col.bold ? 'font-bold group-hover:text-indigo-600' : '' %>">
                                    
                                    <% 
                                       // Если в конфиге есть функция format, используем её, иначе просто выводим значение
                                       let value = item[col.key];
                                       if (col.format) value = col.format(value);
                                    %>
                                    <%= value %>
                                </td>
                            <% }) %>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="flex flex-col items-center justify-center py-40">
            <i class="fas fa-search-minus text-slate-300 text-4xl mb-4"></i>
            <h2 class="text-lg font-bold text-slate-900">Данные не найдены</h2>
        </div>
    <% } %>
</div>
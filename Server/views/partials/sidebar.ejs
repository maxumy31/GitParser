<aside class="w-72 bg-slate-50 border-r border-slate-200 p-8 flex flex-col gap-10">
    <section>
        <h3 class="text-[12px] font-bold text-slate-700 uppercase tracking-[0.15em] mb-6">
            Фильтрация данных
        </h3>
        
        <form id="sidebar-filters-form"
              hx-post="/search" 
              hx-target="#table-container" 
              hx-trigger="change" 
              class="space-y-4">
            
            <label class="block">
                <span class="text-[10px] tracking-[0.15em] text-slate-500 font-bold mb-2 block uppercase">
                    Минимальный порог
                </span>
                <select name="minStars" 
                        class="w-full bg-white border border-slate-200 rounded-md px-3 py-2 text-sm 
                        focus:border-indigo-500 outline-none shadow-sm cursor-pointer transition-all">
                    <option value="0">Любая популярность</option>
                    <option value="1000">Звезд > 1 000</option>
                    <option value="10000">Звезд > 10 000</option>
                    <option value="50000">Звезд > 50 000</option>
                </select>
            </label>

            <label class="flex items-center gap-3 cursor-pointer group py-2">
                <input type="checkbox" 
                       name="mergeSources" 
                       checked 
                       class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 transition-all cursor-pointer">
                <span class="text-sm text-slate-600 group-hover:text-slate-900 font-medium transition-colors">
                    Объединять источники
                </span>
            </label>
            
            <input type="hidden" name="q" id="sidebar-q-sync" value="Frontend">
        </form>
    </section>

    <section>
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.15em] mb-4">
            Быстрые категории
        </span>
        <div class="flex flex-wrap gap-2">
            <% const quickTags = ['Frontend', 'Backend', 'ML', 'Mobile']; %>
            <% quickTags.forEach(tag => { %>
                <button hx-post="/search" 
                        hx-vals='{"q": "<%= tag %>"}'
                        hx-target="#table-container"
                        class="px-3 py-1.5 bg-white border border-slate-200 text-slate-600 text-xs font-semibold rounded-md hover:border-indigo-500 hover:text-indigo-600 transition-all">
                    <%= tag %>
                </button>
            <% }) %>
        </div>
    </section>
</aside>
<div id="table-container" class="max-w-6xl mx-auto animate-pulse">
    <div class="bg-red-50 border border-red-200 rounded-xl p-8 shadow-sm">
        <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 bg-red-600 rounded-lg flex items-center justify-center shadow-lg shadow-red-500/20">
                <i class="fas fa-exclamation-triangle text-white text-xl"></i>
            </div>
            <div>
                <h2 class="text-xl font-bold text-red-900 tracking-tight">Ошибка выполнения запроса</h2>
                <p class="text-sm text-red-600">База данных вернула исключение при обработке данных</p>
            </div>
        </div>

        <div class="space-y-4">
            <div>
                <span class="text-[10px] font-bold text-red-400 uppercase tracking-widest mb-2 block">Текст ошибки</span>
                <div class="bg-white border border-red-100 rounded-lg p-4 font-mono text-xs text-red-800 shadow-inner overflow-x-auto">
                    <%= errorMessage %>
                </div>
            </div>

            <% if (typeof query !== 'undefined') { %>
            <div>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 block">SQL Запрос</span>
                <div class="bg-slate-900 rounded-lg p-4 font-mono text-xs text-indigo-300 shadow-xl overflow-x-auto">
                    <span class="text-slate-500">-- Исполняемый код:</span><br>
                    <%= query %>
                </div>
            </div>
            <% } %>
        </div>

        <div class="mt-8 pt-6 border-t border-red-100 flex justify-between items-center">
            <p class="text-[11px] text-red-400 italic">Попробуйте изменить параметры фильтрации или проверить подключение к PG_HOST</p>
            <button onclick="window.location.reload()" class="px-4 py-2 bg-white border border-red-200 text-red-600 text-xs font-bold rounded-md hover:bg-red-50 transition-colors">
                Перезагрузить страницу
            </button>
        </div>
    </div>
</div>